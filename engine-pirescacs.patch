+template<GenType Type>
+ExtMove* generate_pirescacs(const Position& pos, ExtMove* list) {
+    Color us = pos.side_to_move();
+    auto emit = [&](Move m) {
+        bool tactical = pos.capture(m) || type_of(m) == PIR_RETURN || type_of(m) == PIR_REVIVE
+                     || (type_of(pos.moved_piece(m)) == ROOK && relative_rank(us, to_sq(m)) == RANK_8);
+        if (Type == CAPTURES && !tactical) return;
+        if (Type == QUIETS && tactical) return;
+        if (Type == QUIET_CHECKS && (tactical || !pos.gives_check(m))) return;
+        *list++ = m;
+    };
+    auto pawnMove = [&](Square from, Square to) {
+        if (relative_rank(us, to) == RANK_8) {
+            Bitboard empty = ~(pos.pieces() ^ from) & (us == WHITE ? (Rank1BB | Rank2BB | Rank3BB | Rank4BB) : (Rank5BB | Rank6BB | Rank7BB | Rank8BB));
+            while (empty) emit(make_gating<PIR_RETURN>(from, to, NO_PIECE_TYPE, pop_lsb(empty)));
+        } else emit(make_move(from, to));
+    };
+    for (Bitboard pieces = pos.pieces(us); pieces;) {
+        Square from = pop_lsb(pieces);
+        PieceType pt = type_of(pos.piece_on(from));
+        if (pt == ROOK) {
+            if (relative_rank(us, from) == RANK_8) continue;
+            Square to = Square(from + pawn_push(us));
+            if (pos.empty(to)) emit(make_move(from, to));
+            else if (color_of(pos.piece_on(to)) == us) emit(make<PIR_SWAP>(from, to));
+        } else if (pt == PAWN) {
+            if (relative_rank(us, from) == RANK_8) continue;
+            Square to = Square(from + pawn_push(us));
+            if (pos.empty(to)) {
+                pawnMove(from, to);
+                if ((pos.virgin_pawns() & from) && relative_rank(us, from) == RANK_2 && pos.empty(Square(to + pawn_push(us))))
+                    emit(make_move(from, Square(to + pawn_push(us))));
+            }
+            Bitboard targets = pawn_attacks_bb(us, from) & pos.pieces(~us) & ~pos.pieces(~us, ROOK, KING);
+            while (targets) pawnMove(from, pop_lsb(targets));
+            if (pos.pirescacs_version() >= 4) {
+                Bitboard ep = pawn_attacks_bb(us, from) & pos.ep_squares();
+                while (ep) {
+                    Square epTo = pop_lsb(ep), victim = Square(epTo - pawn_push(us));
+                    if (pos.empty(epTo) && pos.piece_on(victim) == make_piece(~us, PAWN)) emit(make<EN_PASSANT>(from, epTo));
+                }
+            }
+        } else {
+            Bitboard targets = pos.attacks_from(us, pt, from) & ~pos.pieces(us) & ~pos.pieces(~us, ROOK, KING);
+            while (targets) emit(make_move(from, pop_lsb(targets)));
+            if (pt == COMMONER && (pos.pir_medics() & from)) emit(make<PIR_REVIVE>(from, from));
+        }
+    }
+    return list;
+}
